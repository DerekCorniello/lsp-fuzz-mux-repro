# Pinned revisions and toolchain identifiers for the Mux LSPFuzz reproduction.
# Every campaign record must copy these values into its metadata.

# LSPFuzz paper artifact (https://github.com/henryhchchc/lsp-fuzz)
LSP_FUZZ_REPO="https://github.com/henryhchchc/lsp-fuzz.git"
LSP_FUZZ_REV="a1d4c65ad6f0b2160fcfb774250295e2270b0b86"

# Subject program
MUX_COMPILER_REPO="https://github.com/muxlang/mux-compiler.git"
MUX_COMPILER_REV="e0f4d43bd6e51bb48d428bf8ca174415294d08e9"
MUX_RUNTIME_REV="44c164514e2b4b75db10c683dba8c73c58906603"
MUX_EXAMPLES_REPO="https://github.com/muxlang/mux-examples.git"
MUX_EXAMPLES_REV="34698ff5af8279a71148dd87388a74df66449ef7"

# Grammar artifacts (copied into upstream-lsp-fuzz/crates/tree-sitter-mux)
TREE_SITTER_MUX_REPO="https://github.com/muxlang/tree-sitter-mux.git"
TREE_SITTER_MUX_REV="e7a030806b2a1b996078a3101a4655debd4ac51a"

# Toolchain
AFLPP_REPO="https://github.com/AFLplusplus/AFLplusplus.git"
AFLPP_REV="d798677805de81b50aa8f45beb0342ae1617b9d8"
CARGO_AFL_VERSION="0.18.2"
